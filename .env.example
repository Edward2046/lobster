# ============================================================
# Lobster Agent 环境变量示例
# ------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实值。
# 注意：请勿把真实密钥提交到仓库（.env 已被 .gitignore 忽略）。
# 未设置的项都会使用 config/settings.py 里的默认值。
# ============================================================

# ── Agent / 模型（DEEPSEEK_API_KEY 必填）────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key-here
AGENT_MODEL_ID=deepseek/deepseek-reasoner
AGENT_MODEL_ID_FAST=deepseek/deepseek-chat
AGENT_MAX_STEPS=15
AGENT_TIMEOUT=30
AGENT_NUM_RETRIES=0
AGENT_VERBOSITY_LEVEL=1
AGENT_STREAM_ENABLED=true

# ── HTTP 服务 ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8765
FRONTEND_PORT=5173
REQUEST_TIMEOUT=60

# ── 调度器 ─────────────────────────────────────────────────
SCHEDULER_SLEEP_SECONDS=30

# ── 消息推送（可选）─────────────────────────────────────────
# 微信推送 WxPusher：https://wxpusher.zjiecode.com/
WXPUSHER_APP_TOKEN=your-wxpusher-app-token
WXPUSHER_UIDS=your-wxpusher-uid-1,your-wxpusher-uid-2
WXPUSHER_UID=your-wxpusher-uid
# 飞书群自定义机器人 Webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id
NOTIFICATION_TIMEOUT=10

# ── 工具 ───────────────────────────────────────────────────
# 联网搜索 Tavily：https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key
TOOL_HTTP_TIMEOUT=10

# ── 记忆系统（可选）─────────────────────────────────────────
MEMORY_RECENT_LIMIT=5
MEMORY_RELEVANT_LIMIT=6
MEMORY_GOAL_LIMIT=3
MEMORY_REFLECTION_LIMIT=3
MEMORY_RETENTION_DAYS=90
# 语义向量检索（开启需自行安装对应依赖）
MEMORY_VECTOR_ENABLED=false
MEMORY_VECTOR_MODEL=all-MiniLM-L6-v2
MEMORY_VECTOR_TOP_K=8

# ── 系统监控告警阈值（可选）─────────────────────────────────
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90
PROCESS_MEMORY_MB_THRESHOLD=500
DB_SIZE_MB_THRESHOLD=100
LOG_SIZE_MB_THRESHOLD=100
CONTAINER_RESTART_THRESHOLD=5
ALERT_DEDUPE_MINUTES=60

# ── Elasticsearch 日志监控（可选）──────────────────────────
ES_BASE_URL=http://localhost:9200
ES_INDEX_PATTERN=logs-{app_id}-*
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_TIMEOUT=10
ES_LEVEL_FIELD=level
ES_APP_FIELD=app_id
ES_MESSAGE_FIELD=message
ES_TIMESTAMP_FIELD=@timestamp

# 日志突增监控阈值
LOG_MONITOR_WINDOW_MINUTES=5
LOG_MONITOR_BASELINE_WINDOWS=12
LOG_MONITOR_ABS_THRESHOLD=50
LOG_MONITOR_SPIKE_RATIO=3.0
LOG_MONITOR_MIN_BASELINE=5
LOG_MONITOR_SAMPLE_SIZE=5

# ── 日志 ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_BACKUP_DAYS=14
